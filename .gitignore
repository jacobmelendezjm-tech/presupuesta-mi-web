# Dependencias (se instalan con npm install)
node_modules/

# Compilación del cliente React (se genera con npm run build)
cliente/dist/
# Solo la carpeta public/ de la raíz: cliente/public/ tiene imágenes que sí se suben
/public/

# Configuración local de Vercel CLI
.vercel/

# Variables de entorno y credenciales
.env
.env.*

# Registros y archivos del sistema
npm-debug.log*
*.log
.DS_Store
Thumbs.db

# Configuración local del editor/asistente
.claude/

# La plantilla de variables sí se sube (no contiene claves)
!.env.example
